DATABASE_URL="postgresql://postgres:password@localhost:5432/vyntrise_auth?schema=public"
JWT_SECRET=your-jwt-secret-here-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-here-change-in-production
FRONTEND_URL=http://localhost:3001

# Server
PORT=3021
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for cross-origin requests
# Development: Use your local URLs
# Production: Use your actual domain URLs (e.g., https://auth.vyntrise.com,https://sms.vyntrise.com)
# Use * only for development (NOT RECOMMENDED for production)
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# ===== Email =====
# Provider options:
# - "console": logs emails to the console, sends nothing (development default)
# - "smtp":    any SMTP server (SendGrid, Mailgun, AWS SES, your own mail host)
# - "gmail":   Gmail with an App Password (low volume only)
# If the selected provider is missing credentials the service logs an error and falls back
# to "console" rather than refusing to start — check the boot log after changing this.
EMAIL_PROVIDER=console

# Address and display name every email is sent from.
# Defaults to SMTP_USER / GMAIL_USER when unset. Must be an address your provider lets you
# send as, or messages will be rejected or land in spam.
# EMAIL_FROM=noreply@vyntrise.com
EMAIL_FROM_NAME=Vyntrise

# ===== SMTP Configuration (when EMAIL_PROVIDER=smtp) =====
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE defaults to true for port 465 and false otherwise; set it only to override.
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASSWORD=your-smtp-password-or-api-key

# ===== Gmail Configuration (when EMAIL_PROVIDER=gmail) =====
# Requires 2-Step Verification and a 16-character App Password, not the account password.
# GMAIL_USER=your-gmail@gmail.com
# GMAIL_APP_PASSWORD=your-gmail-app-password
