generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  platforms               UserPlatformAccess[]
  passwordResetToken      PasswordResetToken?
  emailVerificationTokens EmailVerificationToken[]
  sessions                Session[]
  auditLogs               AuditLog[]
  inviteKeysCreated       PlatformInviteKey[]
}

model Platform {
  id                    String   @id @default(uuid())
  name                  String   @unique
  description           String?
  allowSelfRegistration Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users       UserPlatformAccess[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  inviteKeys  PlatformInviteKey[]
}

model UserPlatformAccess {
  id         String   @id @default(uuid())
  userId     String
  platformId String
  role       String   @default("USER") // e.g., ADMIN, USER
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([userId, platformId])
}

model Invitation {
  id         String   @id @default(uuid())
  email      String
  platformId String
  role       String   @default("USER") // Role to be assigned when invitation is accepted
  token      String   @unique
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  platform Platform @relation(fields: [platformId], references: [id])

  @@unique([email, platformId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @unique
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id          String   @id @default(uuid())
  userId      String
  hashedToken String   @unique
  userAgent   String?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  platformId String?
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  platform Platform? @relation(fields: [platformId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([platformId, createdAt])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String
  // The address the token was issued for. Stored alongside the user because a pending change
  // of email must not mark the *new* address verified if the user reverts before clicking.
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A credential that lets one platform's own backend create invitations for itself, without a
// human opening the admin panel. Deliberately bound to a single platform at creation: a leaked
// key can only invite people into the platform it was issued for, which is the same blast radius
// a human admin of that platform already has.
model PlatformInviteKey {
  id         String    @id @default(uuid())
  platformId String
  // SHA-256 of the key, for the same reason invite and reset tokens are hashed (see
  // utils/token.ts): the key is 256 bits of CSPRNG output, so a database read yields digests
  // rather than working credentials, and the digest stays indexable for per-request lookup.
  keyHash    String    @unique
  // First few characters of the raw key, kept in the clear so the admin page can show *which*
  // key is live. Far too short to narrow the search space.
  prefix     String
  createdAt  DateTime  @default(now())
  createdById String?
  lastUsedAt DateTime?
  revokedAt  DateTime?

  platform  Platform @relation(fields: [platformId], references: [id])
  createdBy User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  // Issuing a key revokes the platform's previous one, so in practice there is a single live key
  // per platform; revoked rows are kept for the audit trail. Two admins clicking Generate at the
  // same instant could interleave and leave two live keys — harmless, since both are scoped to
  // this same platform and Revoke clears every live key at once, not just the newest.
  @@index([platformId, revokedAt])
}

model SigningKey {
  id            String    @id @default(uuid())
  // Published in the JWT header so a verifier knows which public key to check against, which
  // is what makes rotation possible without invalidating tokens signed by the previous key.
  kid           String    @unique
  algorithm     String    @default("RS256")
  publicJwk     Json
  privateKeyPem String
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  retiredAt     DateTime?

  @@index([isActive])
}
